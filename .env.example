# ============================================================
#  MYBE — Environment Variables
#  Copy this to .env.local and fill in the values
# ============================================================

# ──────────────────────────────────────────────
# 1. NVIDIA NIM API Key (TRELLIS text-to-3D)
# ──────────────────────────────────────────────
NVIDIA_API_KEY=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

# ──────────────────────────────────────────────
# 2. Firebase Client SDK (public keys — safe to expose)
#    Get from: Firebase Console → Project Settings → Your Apps → Web App
# ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=           # e.g. AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=void-builder-14923.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=void-builder-14923
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=void-builder-14923.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1092986292860
NEXT_PUBLIC_FIREBASE_APP_ID=1:1092986292860:web:4e4937eae4a102856717f9

# ──────────────────────────────────────────────
# 3. Firebase Admin SDK (SECRET — never expose publicly)
#    Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
#    Download the JSON, copy client_email and private_key
# ──────────────────────────────────────────────
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@void-builder-14923.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────
# 4. Vercel Blob Storage (for storing GLB model files)
#    Get from: vercel.com → Your Project → Storage → Blob → Create Store → copy token
# ──────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
